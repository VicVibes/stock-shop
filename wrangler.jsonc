{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "stock-shop",
	"main": "worker/index.js",
	"compatibility_date": "2026-10-06",
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "stock-shop",
			"database_id": "9001e1e0-573b-4bf4-b604-f296915f7d08",
			"migrations_dir": "migrations"
		}
	],
	"vars": {
		"STOCK_USER": "Storekeeper"
	}
}
